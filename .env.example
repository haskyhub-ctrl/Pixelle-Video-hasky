# Stock Matcher credentials (copy to .env - never commit .env)

# ---- Free providers ----
# https://www.pexels.com/api/new/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ---- Premium providers (licensed downloads count against your plan) ----
# Shutterstock API v2 OAuth token with the `licenses.create` scope
SHUTTERSTOCK_API_TOKEN=
SHUTTERSTOCK_SUBSCRIPTION_ID=
# sd | hd | 4k
SHUTTERSTOCK_VIDEO_SIZE=hd

# Storyblocks API v2
STORYBLOCKS_PUBLIC_KEY=
STORYBLOCKS_PRIVATE_KEY=
STORYBLOCKS_USER_ID=
STORYBLOCKS_PROJECT_ID=

# ---- Optional LLM for keyword extraction / translation ----
# Backend: openai (any OpenAI-compatible API) | ollama | anthropic
# When unset, the `llm` section of config.yaml is used if configured.
STOCK_LLM_BACKEND=
STOCK_LLM_MODEL=
STOCK_LLM_API_KEY=
STOCK_LLM_BASE_URL=
# Examples:
#   STOCK_LLM_BACKEND=ollama     STOCK_LLM_MODEL=llama3.2
#   STOCK_LLM_BACKEND=openai     STOCK_LLM_MODEL=gpt-4o-mini   STOCK_LLM_API_KEY=sk-...
#   STOCK_LLM_BACKEND=anthropic  STOCK_LLM_MODEL=claude-opus-5-5  (uses ANTHROPIC_API_KEY)
