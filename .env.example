# Sao chép file này thành .env rồi điền key của bạn.
# App tự đọc .env khi khởi động (không ghi đè biến môi trường đã có).
# .env đã được .gitignore — không bị đẩy lên repo.

# ----- LLM (bắt buộc cho các chức năng AI) -----
# OpenAI:    LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o
# DeepSeek:  LLM_BASE_URL=https://api.deepseek.com           LLM_MODEL=deepseek-chat
# Qwen:      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-max
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ----- Nghiên cứu ngách -----
# YouTube Data API v3 (bắt buộc): console.cloud.google.com → bật YouTube Data API v3 → tạo API key
YOUTUBE_API_KEY=
# TikHub (tuỳ chọn, trả phí): tikhub.io — cho TikTok, Douyin, Xiaohongshu, Kuaishou, Bilibili...
TIKHUB_API_KEY=

NICHE_DEFAULT_REGION=VN
NICHE_DEFAULT_LANGUAGE=vi
